---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PostList from '../components/PostList.astro';
import { listPosts } from '../lib/posts';
import { PIKOS } from '../consts';

const posts = (await listPosts()).slice(0, 4);
---

<Base>
  <div class="lead">
    <p>
      Hi, I'm Alex. I live in Seattle and work remotely as a staff software
      engineer at Solace Health. The work I like best is untangling the
      problems a team has learned to live with.
    </p>
    <p>
      On the side I'm building <a href={PIKOS.site}>Pikos</a>, because I wanted
      my notes, tasks, and calendar in one app. There's no account, nothing leaves your device unless
      you want it to, and <a href={PIKOS.repo}>the code is public</a> if you're
      curious how it works.
    </p>
  </div>

  <hr />

  <Section label="Writing">
    <PostList posts={posts} empty="First one is in progress." />
  </Section>
</Base>

<style>
  .lead {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .lead p {
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
    font-weight: 300;
  }
</style>
