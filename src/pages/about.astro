---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { EMAIL, PIKOS } from '../consts';

const values = [
  {
    label: 'Follow the campsite rule.',
    text: 'Code and docs left a little better on every pass, so the next person has an easier time.',
  },
  {
    label: 'Fix the pattern.',
    text: "When the same bug keeps turning up in new places, I go after what's letting it in.",
  },
  {
    label: 'Say it early.',
    text: "If something's running late, people hear it the same day, along with a new plan.",
  },
  {
    label: "Make other people's work easier.",
    text: "It's why I like writing the guide, and why mentoring is one of my favorite parts of the job.",
  },
  {
    label: "Take care of people's data.",
    text: 'I keep it accurate and treat it like my own.',
  },
  {
    label: 'Build things people are glad they used.',
    text: 'Nothing designed to keep them hooked.',
  },
];

const testimonials = [
  {
    text: "[Alex's] architecture is really easy to work with and to make rapid and effective modifications to.",
    cite: 'Chris Psiaki, CTO, Topia',
  },
  {
    text: "He's extremely organized and an underpromise/overdeliver kind of guy. He's not a sandbagger, but he is smart and sharp about setting realistic expectations.",
    cite: 'Mark Bullard, Founder, BrainSquall',
  },
  {
    text: 'His work ethic, eye for detail, and thoughtful, curious approach to both the technical and the interpersonal have set him apart.',
    cite: 'Corinne Cooley, Founder, Matrix Multiplier Consulting',
  },
];
---

<Base
  title="About"
  description="Born in Montreal, raised in northern Nevada, now a staff software engineer in Seattle."
>
  <div class="intro">
    <h1>About</h1>

    <div class="prose">
      <p>
        I'm Alex. Born in Montreal, raised in northern Nevada, and now living
        in Seattle. I'm a staff software engineer at Solace Health, working
        remotely, and before that I was the first engineer hired at two
        startups, Topia and BrainSquall.
      </p>
      <p>
        As a biologist turned yoga instructor turned software engineer, I can
        say with some authority that miniature dachshunds are objectively the
        best kind of dog. I live with one.
      </p>
      <p>
        Off the clock it's usually coffee, a bike ride, or something fermenting
        on the counter while something else bakes. Also more code, because I
        like it, which is how <a href={PIKOS.site}>Pikos</a> happened.
      </p>
    </div>
  </div>

  <Section label="How I like to work">
    <ul class="values">
      {values.map((value) => (
        <li>
          <strong>{value.label}</strong> {value.text}
        </li>
      ))}
    </ul>
  </Section>

  <Section label="Kind words">
    <div class="testimonials">
      {testimonials.map((quote) => (
        <blockquote>
          <p>{quote.text}</p>
          <cite>{quote.cite}</cite>
        </blockquote>
      ))}
    </div>
  </Section>

  <p>
    If you want to talk shop, or bread, <a href={EMAIL}>email</a>'s the best way
    to reach me.
  </p>
</Base>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-title);
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-block);
  }

  .values {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-block);
  }

  strong {
    font-weight: 600;
  }

  .testimonials {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  blockquote {
    margin: 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent-soft);
    display: flex;
    flex-direction: column;
    gap: var(--space-tight);
  }

  blockquote p {
    font-style: italic;
  }

  cite {
    font-size: var(--text-small);
    font-style: normal;
    color: var(--muted);
  }
</style>
