---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { listPosts } from '../../lib/posts';

const posts = await listPosts();
---

<Base
  title="Writing"
  description="Essays on how the work gets done: making fixes stick, growing into staff, and working alongside coding agents."
>
  <div class="page">
    <header>
      <h1>Writing</h1>
      <p>
        Short, practical notes on what I've learned building software and
        working on teams. I draft with Claude as an editor, then rewrite until
        it sounds like me.
      </p>
    </header>
    <PostList posts={posts} empty="First one is in progress." />
  </div>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--space-title);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  header p {
    color: var(--muted-strong);
  }
</style>
