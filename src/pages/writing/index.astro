---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { listPosts } from '../../lib/posts';

const posts = await listPosts();
---

<Base
  title="Writing"
  description="Writing on how the work actually gets done: making fixes stick, growing into staff, and working alongside coding agents."
>
  <h1>Writing</h1>
  <PostList posts={posts} empty="First one is in progress." />
</Base>

<style>
  h1 {
    font-size: 2.25rem;
    font-weight: 400;
  }
</style>
