---
import Base from './Base.astro';
import { formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, published, updated } = post.data;
---

<Base title={title} description={description}>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={published.toISOString()}>{formatDate(published)}</time>
        {updated && <span> · updated {formatDate(updated)}</span>}
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  article {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 400;
  }

  .meta {
    font-size: var(--text-small);
    color: var(--muted);
  }

  /* Headings take their space above and give little below, so each one reads
     as attached to the text it introduces. */
  .prose :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .prose :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.375rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 1.125rem;
  }

  .prose :global(li) {
    margin-top: 0.375rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }

  .prose :global(blockquote) {
    margin: 1.75rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent-soft);
    font-style: italic;
  }

  .prose :global(code) {
    font-size: 0.9em;
    background: var(--rule);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
  }

  .prose :global(pre) {
    margin: 1.75rem 0;
    padding: 1rem 1.125rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow-x: auto;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(img) {
    border-radius: var(--radius);
  }
</style>
