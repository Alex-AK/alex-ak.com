---
import Base from './Base.astro';
import { formatDate, type Post } from '../lib/posts';
import { EMAIL, PIKOS } from '../consts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, published, updated } = post.data;
---

<Base title={title} description={description} type="article">
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={published.toISOString()}>{formatDate(published)}</time>
        {updated && <span> · updated {formatDate(updated)}</span>}
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
    <footer class="signoff">
      <p>
        I'm <a href="/about">Alex</a>, a staff software engineer in Seattle,
        mostly on the backend. On the side I'm building
        <a href={PIKOS.site}>Pikos</a>, and
        <a href={PIKOS.repo}>the code is public</a>.
      </p>
      <p>
        Want to talk shop, or think I got this wrong?
        <a href={EMAIL}>Email me</a>.
      </p>
    </footer>
  </article>
</Base>

<style>
  article {
    display: flex;
    flex-direction: column;
    gap: var(--space-title);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .meta {
    font-size: var(--text-small);
    color: var(--muted);
  }

  /* The short sage rule is the brand's cursor turned on its side: it marks
     the change of speaker without the weight of a full-width divider. */
  .signoff {
    position: relative;
    padding-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-tight);
    color: var(--muted-strong);
  }

  .signoff::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 2.5rem;
    height: 2px;
    background: var(--accent-soft);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: var(--space-block);
  }

  /* Headings take their space above and give little below, so each one reads
     as attached to the text it introduces. The `+ *` rule is what enforces
     that: a bottom margin alone collapses into the next paragraph's larger
     top margin. */
  .prose :global(h2) {
    margin-top: 2.5rem;
    font-size: var(--text-lead);
  }

  .prose :global(h3) {
    margin-top: 1.75rem;
    font-size: var(--text-heading);
  }

  .prose :global(:is(h2, h3) + *) {
    margin-top: var(--space-tight);
  }

  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(li) {
    margin-top: 0.375rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }

  .prose :global(blockquote) {
    margin: 1.75rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent-soft);
    font-style: italic;
  }

  .prose :global(code) {
    font-size: 0.9em;
    background: var(--rule);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
  }

  .prose :global(pre) {
    margin: 1.75rem 0;
    padding: 1rem 1.125rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow-x: auto;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(img) {
    border-radius: var(--radius);
  }
</style>
