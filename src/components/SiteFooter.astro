---
import { SOCIALS } from '../consts';
---

<footer>
  <p>
    Before software I was a biologist and a yoga instructor. I live in Seattle
    with a dachshund, the best kind of dog.
  </p>
  <p class="links">
    {SOCIALS.map((social, i) => (
      <>
        {i > 0 && <span aria-hidden="true"> · </span>}
        <a href={social.href}>{social.label}</a>
      </>
    ))}
  </p>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .links span {
    color: var(--muted);
    padding: 0 0.25rem;
  }
</style>
