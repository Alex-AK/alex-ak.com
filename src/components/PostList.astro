---
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
  empty?: string;
}

const { posts, empty = 'Nothing published yet.' } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/writing/${post.id}`} class="title">
            {post.data.title}
          </a>
          <p class="description">{post.data.description}</p>
        </li>
      ))}
    </ul>
  )
}

<style>
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-block);
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .title {
    color: var(--ink);
    font-size: 1.3125rem;
    line-height: var(--leading-tight);
  }

  .description {
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--muted);
  }

  .empty {
    color: var(--muted);
  }
</style>
